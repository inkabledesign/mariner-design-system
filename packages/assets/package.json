{
  "name": "@inkabledesign/mariner-assets",
  "version": "1.0.1",
  "type": "module",
  "description": "Icons, fonts, and images for Mariner design system",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "react-native": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.esm.js"
    },
    "./fonts": {
      "react-native": "./fonts/index.ts",
      "types": "./dist/fonts/index.d.ts",
      "import": "./dist/fonts/index.esm.js",
      "require": "./dist/fonts/index.js",
      "default": "./dist/fonts/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.*",
    "dist/fonts",
    "dist/icons",
    "dist/images",
    "icons",
    "fonts",
    "images"
  ],
  "scripts": {
    "generate:icons": "node icons/icons-gen.cjs",
    "build": "npm run generate:icons && rollup -c && mkdir -p dist/fonts && cp fonts/*.ttf dist/fonts/",
    "dev": "mkdir -p dist/fonts && cp fonts/*.ttf dist/fonts/ && rollup -c -w",
    "test": "echo \"No tests for assets package\"",
    "lint": "echo \"No linting for assets package\""
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "cheerio": "^1.2.0",
    "rollup": "^4.6.0",
    "typescript": "^5.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.83.0",
    "react-native-svg": "^15.15.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inkabledesign/mariner-design-system.git",
    "directory": "packages/assets"
  }
}
