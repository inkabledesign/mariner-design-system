{
  "name": "@inkabledesign/mariner-components",
  "version": "2.0.1",
  "type": "module",
  "description": "Cross-platform React Native components for Mariner applications",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "react-native": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "atoms",
    "molecules",
    "organisms",
    "templates",
    "hooks",
    "types",
    "data",
    "utils"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "echo \"No tests for components package\"",
    "lint": "echo \"No linting for components package\""
  },
  "peerDependencies": {
    "@inkabledesign/mariner-assets": "^2.0.0",
    "@inkabledesign/mariner-theme": "*",
    "expo-image": ">=58.0.16",
    "nativewind": "^4.0.0",
    "react": "^19.3.0",
    "react-native": ">=0.88.0",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": ">=5.10.1",
    "react-native-svg": "^15.16.0",
    "tailwindcss": "^3.4.0",
    "react-native-worklets": "^0.13.0"
  },
  "peerDependenciesMeta": {
    "expo-image": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.0.0",
    "@types/react": "~19.3.0",
    "rollup": "^4.6.0",
    "typescript": "^5.2.0"
  },
  "publishConfig": {
    "registry": "https://registry.figma.com/npm/aead56d4-5c30-4a37-9fea-416be436e316/registry/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inkabledesign/mariner-design-system.git",
    "directory": "packages/components"
  }
}
